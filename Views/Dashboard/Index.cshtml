@model TodoList.ViewModels.DashboardViewModel

<div class="dashboard-layout">

    @{
        var sidebarModel = new TodoList.ViewModels.SidebarViewModel
        {
            FullName = Model.FullName
        };
    }

<partial name="~/Views/Shared/Partials/_Sidebar.cshtml"
         model="sidebarModel" />

    <!-- MAIN -->
    <main class="main-content">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div class="welcome-box">
                <h1>خوش آمدی، @Model.FullName 👋</h1>
                <p>امروز یک روز عالی برای مدیریت کارهاست</p>
            </div>

        </div>

        <!-- STATS -->
        <section class="stats-section">

            <div class="stat-card">
                <h3>@Model.TotalTasks</h3>
                <span>کل تسک‌ها</span>
            </div>

            <div class="stat-card">
                <h3>@Model.CompletedTasks</h3>
                <span>انجام شده</span>
            </div>

            <div class="stat-card">
                <h3>@Model.InProgressTasks</h3>
                <span>در حال انجام</span>
            </div>

            <div class="stat-card">
                <h3>@Model.TodayTasks</h3>
                <span>امروز</span>
            </div>

        </section>

        <!-- SEARCH -->
        <div class="search-box">
            <input type="text"
                   name="search"
                   value="@Model.SearchTerm"
                   placeholder="جستجو در تسک‌ها..." />
        </div>

        <!-- TASKS -->
        <section class="tasks-section">

            @if (Model.Tasks == null || !Model.Tasks.Any())
            {
                <div class="empty-state">
                    هیچ تسکی وجود ندارد 🚀
                </div>
            }
            else
            {
                foreach (var task in Model.Tasks)
                {
                    <partial name="~/Views/Shared/Partials/_TaskCard.cshtml"
                             model="task" />
                }
            }

        </section>

    </main>

</div>
