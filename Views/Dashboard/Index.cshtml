@model TodoList.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
    Layout = "_Layout";
}


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;800&display=swap"
      rel="stylesheet">

<div class="dashboard-container">

    <div class="welcome-section">

        <div>
            <h1>خوش برگشتی @Model.FullName 👋</h1>
            <p>مدیریت کارهات رو از اینجا انجام بده</p>
        </div>

        <button class="add-task-btn" data-bs-toggle="modal" data-bs-target="#createTaskModal">
             + تسک جدید 
        </button>

    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <h2>@Model.TotalTasks</h2>
            <span>کل تسک‌ها</span>
        </div>

        <div class="stat-card">
            <h2>@Model.CompletedTasks</h2>
            <span>تکمیل شده</span>
        </div>

        <div class="stat-card">
            <h2>@Model.PendingTasks</h2>
            <span>در حال انجام</span>
        </div>

    </div>


@foreach (var task in Model.RecentTasks)
{
    <div class="task-card @(task.IsCompleted ? "completed" : "")">

        <div class="task-info">

            <h4>@task.Title</h4>

            <p>@task.Description</p>

        </div>

        <div class="task-right">

            @if (task.IsCompleted)
            {
                <span class="badge done">
                    انجام شده
                </span>
            }
            else
            {
                <span class="badge pending">
                    در انتظار
                </span>
            }

            <div class="d-flex gap-2 mt-3">

                @if (!task.IsCompleted)
                {
                    <form asp-action="CompleteTask" method="post">

                        <input type="hidden"
                               name="id"
                               value="@task.Id" />

                        <button class="btn btn-success"
                                style="width:100px">
                            انجام شد
                        </button>

                    </form>
                }

                <button type="button"
                        class="btn btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteTaskModal"
                        data-taskid="@task.Id">

                    حذف

                </button>

            </div>

        </div>

    </div>
}

        

</div>

<div class="modal fade"
     id="createTaskModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content bg-dark text-white">

            <div class="modal-header">

                <h5 class="modal-title">
                    ایجاد تسک جدید
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="CreateTask"
                  asp-controller="Dashboard"
                  method="post">

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            عنوان
                        </label>

                        <input name="Title"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            توضیحات
                        </label>

                        <textarea name="Description"
                                  rows="4"
                                  class="form-control">
                        </textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        انصراف

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ثبت تسک

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<div class="modal fade"
     id="deleteTaskModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content bg-dark text-white">

            <div class="modal-header">

                <h5 class="modal-title">
                    تایید حذف
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                آیا از حذف این تسک مطمئن هستید؟

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    انصراف
                </button>

                <form asp-action="DeleteTask"
                      method="post">

                    <input type="hidden"
                           id="deleteTaskId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger">
                        حذف
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    document
    .getElementById('deleteTaskModal')
    .addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;

        var taskId = button.getAttribute('data-taskid');

        document.getElementById('deleteTaskId').value = taskId;
    });
</script>


<style>

    body {
        background: #0f172a;
        color: white;
        font-family: 'Vazirmatn', sans-serif;
        direction: rtl;
    }

    .dashboard-container {
        padding: 40px;
    }

    .welcome-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .welcome-section h1 {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .welcome-section p {
        color: #94a3b8;
        margin: 0;
    }

    .add-task-btn {
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        border: none;
        padding: 14px 24px;
        color: white;
        border-radius: 16px;
        font-weight: 700;
        transition: 0.3s;
        cursor: pointer;
        font-family: inherit;
    }

    .add-task-btn:hover {
        transform: translateY(-3px);
        opacity: 0.9;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        padding: 30px;
        border-radius: 24px;
        backdrop-filter: blur(12px);
    }

    .stat-card h2 {
        font-size: 42px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .stat-card span {
        color: #94a3b8;
        font-size: 15px;
    }

    .tasks-section {
        background: rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.06);
    }

    .section-header {
        margin-bottom: 25px;
    }

    .section-header h3 {
        font-size: 24px;
        font-weight: 700;
    }

    .task-card {
        background: rgba(255,255,255,0.05);
        padding: 20px;
        border-radius: 18px;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.3s;
    }

    .task-card:hover {
        transform: translateY(-3px);
    }

    .task-card h4 {
        margin-bottom: 8px;
        font-size: 18px;
    }

    .task-card p {
        color: #94a3b8;
        margin: 0;
        font-size: 14px;
    }

    .badge {
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
    }

    .pending {
        background: rgba(245,158,11,0.2);
        color: #fbbf24;
    }

    .done {
        background: rgba(34,197,94,0.2);
        color: #4ade80;
    }

    .progress {
        background: rgba(59,130,246,0.2);
        color: #60a5fa;
    }

    .completed {
        opacity: 0.8;
    }

    .task-info {
    flex: 1;
    }

    .task-right {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 220px;
    }


</style>

