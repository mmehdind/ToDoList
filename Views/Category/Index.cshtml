@using TodoList.ViewModels
@model List<TodoList.ViewModels.CategoryViewModel>

@{
    var sidebarModel = new SidebarViewModel
    {
        FullName = User.Identity?.Name ?? ""
    };
} 

<div class="dashboard-layout">

    <partial name="~/Views/Shared/Partials/_Sidebar.cshtml"
             model="sidebarModel" />

    <main class="main-content">

    <div class="category-page">


        <div class="category-header">

            <div>
                <h1>دسته‌بندی‌ها</h1>
                <p>مدیریت دسته‌بندی‌های تسک‌ها</p>
            </div>

            <button class="add-category-btn"
            onclick="openCategoryModal()">
                + دسته‌بندی جدید
            </button>

        </div>

        <div class="categories-grid">

            @if (!Model.Any())
            {
                <div class="empty-state">
                    هیچ دسته‌بندی‌ای وجود ندارد
                </div>
            }
            else
            {
                @foreach (var category in Model)
                {
                    <div class="category-card">

                        <div class="category-info">

                            <span class="category-dot"
                                style="background:@category.ColorHex">
                            </span>

                            <span class="category-name">
                                @category.Name
                            </span>

                        </div>

                        <div class="category-actions">

                            <a href="#"
                                class="edit-btn"
                                onclick="openEditCategoryModal(
                                        @category.Id,
                                        '@category.Name',
                                        @category.ColorIndex
                                )">
                                ✏
                            </a>

                            <form asp-action="Delete"
                                method="post">

                                <input type="hidden"
                                    name="id"
                                    value="@category.Id" />

                                <button type="submit"
                                        class="delete-btn">

                                    🗑

                                </button>

                            </form>

                        </div>

                    </div>
                }
            }

        </div>

        <script>

            function openCategoryModal()
            {
                document
                    .getElementById("createCategoryModal")
                    .classList.add("active");
            }

            function closeCategoryModal()
            {
                document
                    .getElementById("createCategoryModal")
                    .classList.remove("active");
            }

    </script>

    <script>

        function openEditCategoryModal(
            id,
            name,
            colorIndex)
        {
            document
                .getElementById("editCategoryId")
                .value = id;

            document
                .getElementById("editCategoryName")
                .value = name;

            document
                .getElementById("editCategoryColor")
                .value = colorIndex;

            document
                .getElementById("editCategoryModal")
                .classList.add("active");
        }

        function closeEditCategoryModal()
        {
            document
                .getElementById("editCategoryModal")
                .classList.remove("active");
        }

    </script>

    </div>
</div>


<div class="modal-overlay"
     id="createCategoryModal">

    <div class="modal-box">

        <div class="modal-header">

            <h2>دسته‌بندی جدید</h2>

            <button type="button"
                    class="close-modal-btn"
                    onclick="closeCategoryModal()">
                ✕
            </button>

        </div>

        <form asp-controller="Category"
              asp-action="Create"
              method="post">

            <div class="form-group">

                <label>
                    نام دسته‌بندی
                </label>

                <input type="text"
                       name="Name"
                       required />

            </div>

            <div class="form-group">

                <label>
                    رنگ
                </label>

                <select name="ColorIndex" required>

                    @foreach (var color in TodoList.StaticData.CategoryColors.Colors)
                    {
                        <option value="@color.Id">
                            @color.Name
                        </option>
                    }

                </select>

            </div>

            <button type="submit"
                    class="submit-category-btn">

                ایجاد دسته‌بندی

            </button>

        </form>

    </div>

</div>

<div class="modal-overlay"
     id="editCategoryModal">

    <div class="modal-box">

        <div class="modal-header">

            <h2>
                ویرایش دسته‌بندی
            </h2>

            <button type="button"
                    class="close-modal-btn"
                    onclick="closeEditCategoryModal()">
                ✕
            </button>

        </div>

        <form asp-action="Edit"
              method="post">

            <input type="hidden"
                   id="editCategoryId"
                   name="Id" />

            <div class="form-group">

                <label>
                    نام
                </label>

                <input type="text"
                       id="editCategoryName"
                       name="Name"
                       required />

            </div>

            <div class="form-group">

                <label>
                    رنگ
                </label>

                <select id="editCategoryColor"
                        name="ColorIndex">

                    @foreach (var color in TodoList.StaticData.CategoryColors.Colors)
                    {
                        <option value="@color.Id">
                            @color.Name
                        </option>
                    }

                </select>

            </div>

            <button type="submit"
                    class="submit-category-btn">

                ذخیره تغییرات

            </button>

        </form>

    </div>

</div>
