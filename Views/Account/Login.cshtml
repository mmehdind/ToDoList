@model TodoList.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "ورود";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود</title>

    <link href="~/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: linear-gradient(135deg, #111827, #1f2937, #0f172a);
            color: white;
            font-family: Tahoma, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 460px;
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
            background: rgba(17, 24, 39, 0.92);
            backdrop-filter: blur(10px);
            color: white;
        }

        .login-header {
            text-align: center;
            padding: 2rem 1.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .login-title {
            font-weight: 800;
            margin-bottom: 0.35rem;
            color: white;
        }

        .login-subtitle {
            color: rgba(255,255,255,0.75);
            font-size: 0.95rem;
        }

        .login-body {
            padding: 1.5rem 2rem 2rem;
        }

        .form-label {
            color: rgba(255,255,255,0.9);
        }

        .form-control {
            border-radius: 14px;
            padding: 0.85rem 1rem;
            background: rgba(255,255,255,0.96);
            border: 1px solid rgba(255,255,255,0.15);
        }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
            border-color: #ffc107;
        }

        .btn-login {
            border-radius: 14px;
            padding: 0.9rem;
            font-weight: 800;
            background: #ffc107;
            border-color: #ffc107;
            color: #111827;
        }

        .btn-login:hover {
            background: #ffca2c;
            border-color: #ffca2c;
            color: #111827;
        }

        .input-group .btn {
            border-radius: 14px;
        }

        .small-links,
        .small-links a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
        }

        .small-links a:hover {
            text-decoration: underline;
            color: white;
        }

        .form-check-label {
            color: rgba(255,255,255,0.85);
        }

        .text-danger {
            color: #ff8a8a !important;
        }

        .input-group .btn-outline-light {
            border-color: rgba(255,255,255,0.15);
            color: white;
            background: rgba(255,255,255,0.06);
        }

        .input-group .btn-outline-light:hover {
            background: rgba(255,255,255,0.12);
        }
    </style>
</head>
<body>

    <div class="card login-card">
        <div class="login-header">
            <h3 class="login-title">ورود به حساب کاربری</h3>
            <p class="login-subtitle">برای ادامه وارد شوید</p>
        </div>

        <div class="login-body">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">نام کاربری</label>
                    <input asp-for="UserName" class="form-control" placeholder="نام کاربری خود را وارد کنید" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">رمز عبور</label>
                    <div class="input-group">
                        <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="رمز عبور" />
                        <button class="btn btn-outline-light" type="button" id="togglePassword">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label>
                    </div>
                    <a asp-action="ForgotPassword" class="small-links">فراموشی رمز؟</a>
                </div>

                <button type="submit" class="btn btn-login w-100">ورود</button>

                <div class="text-center mt-4 small-links">
                    حساب ندارید؟
                    <a asp-action="Register" asp-controller="Account">ثبت‌نام کنید</a>
                </div>
            </form>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');
        const icon = togglePassword.querySelector('i');

        togglePassword.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
        });
    </script>
</body>
</html>
